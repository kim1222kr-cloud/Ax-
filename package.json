{
  "name": "feelm-content-agents",
  "version": "0.1.0",
  "private": true,
  "description": "(주)필름 카드뉴스·숏폼 기획-제작-발행 에이전트 팀 도구",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "new": "node --env-file-if-exists=.env tools/new-campaign.mjs",
    "catalog": "node --env-file-if-exists=.env tools/catalog-report.mjs",
    "render:card": "node --env-file-if-exists=.env tools/render-cardnews.mjs",
    "build:short": "node --env-file-if-exists=.env tools/build-shortform.mjs",
    "lint:copy": "node --env-file-if-exists=.env tools/lint-copy.mjs",
    "approve": "node --env-file-if-exists=.env tools/approve.mjs",
    "publish:ig": "node --env-file-if-exists=.env tools/publish-instagram.mjs",
    "publish:yt": "node --env-file-if-exists=.env tools/publish-youtube.mjs",
    "metrics": "node --env-file-if-exists=.env tools/fetch-metrics.mjs",
    "check:approval": "node tools/check-approval.mjs",
    "test": "node --test tools/test/*.test.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/noto-serif-kr": "^5.3.0",
    "playwright": "^1.56.1",
    "pretendard": "^1.3.9"
  }
}
