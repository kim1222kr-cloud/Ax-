# config/env.example — 프로젝트 루트에 .env 로 복사해서 값을 채우세요:  cp config/env.example .env
# (.env 는 git에 올라가지 않고, 에이전트는 .env 를 읽을 수 없도록 .claude/settings.json 에서 막혀 있습니다)

# ── 인스타그램 (Instagram Graph API · 프로페셔널 계정) ──
IG_USER_ID=
IG_ACCESS_TOKEN=
# Instagram Login 방식이면 graph.instagram.com
IG_GRAPH_HOST=graph.facebook.com
IG_API_VERSION=v23.0

# ── 미디어 공개 호스팅 (인스타 API는 공개 HTTPS URL에서 파일을 가져감) ──
# {file}, {key} 치환. 큰따옴표로 감싸 주세요.
MEDIA_UPLOAD_CMD='aws s3 cp "{file}" "s3://feelm-media/{key}" --acl public-read'
MEDIA_PUBLIC_BASE_URL=https://media.feelmgroup.com

# ── 유튜브 (YouTube Data API v3, OAuth 리프레시 토큰) ──
# scope: https://www.googleapis.com/auth/youtube.upload , https://www.googleapis.com/auth/yt-analytics.readonly
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ── TTS (하나만 골라 shortform.json 의 voice.provider 에 지정) ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
CLOVA_CLIENT_ID=
CLOVA_CLIENT_SECRET=
CLOVA_SPEAKER=nara
SUPERTONE_API_KEY=
SUPERTONE_VOICE_ID=

# ── 기타 ──
# CHROMIUM_PATH=/path/to/chrome
# FFMPEG_PATH=/usr/bin/ffmpeg
